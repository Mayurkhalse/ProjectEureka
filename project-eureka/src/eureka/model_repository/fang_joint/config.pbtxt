name: "fang_joint"
platform: "onnxruntime_onnx"
max_batch_size: 64

# Dynamic batching configuration for high-throughput vectorized aggregation
dynamic_batching {
  preferred_batch_size: [8, 16, 32, 64]
  max_queue_delay_microseconds: 2000
}

input [
  {
    name: "claim_emb"
    data_type: TYPE_FP32
    dims: [ 768 ]
  },
  {
    name: "source_feat"
    data_type: TYPE_FP32
    dims: [ 16 ]
  },
  {
    name: "context_feat"
    data_type: TYPE_FP32
    dims: [ 32 ]
  }
]

output [
  {
    name: "rumor_logits"
    data_type: TYPE_FP32
    dims: [ 2 ]
  },
  {
    name: "cred_score"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]
