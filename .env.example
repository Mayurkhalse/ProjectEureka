# NousResearch Hermes Agent (Documented API Server & CLI)
HERMES_API_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=your_hermes_api_server_key_min_16_chars
API_SERVER_KEY=your_hermes_api_server_key_min_16_chars
