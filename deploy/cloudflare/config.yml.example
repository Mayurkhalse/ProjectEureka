# ==============================================================================
# Cloudflare Named Tunnel Configuration Template (EUREKA / SAVI Backend)
# ==============================================================================
# Place this file at ~/.cloudflared/config.yml (Linux/macOS) or
# %USERPROFILE%\.cloudflared\config.yml (Windows) when using CLI-managed tunnels.
#
# Replace <TUNNEL_ID> with the UUID generated by: cloudflared tunnel create <NAME>
# Replace <YOUR_DOMAIN> with your Cloudflare-managed domain (e.g., eureka.gov.in).

tunnel: <TUNNEL_ID>
credentials-file: /etc/cloudflared/<TUNNEL_ID>.json

# Protocol options: auto, http2, or quic
protocol: http2

ingress:
  # --------------------------------------------------------------------------
  # 1. API Ingress: Routes all API traffic to the FastAPI backend (Port 8000)
  # --------------------------------------------------------------------------
  - hostname: api.<YOUR_DOMAIN>
    service: http://127.0.0.1:8000
    originRequest:
      noTLSVerify: true
      connectTimeout: 30s
      keepAliveTimeout: 90s
      http2Origin: true
      # Disable chunked encoding buffering for real-time SSE streaming (OpenUI Copilot)
      chunkedEncoding: true

  # --------------------------------------------------------------------------
  # 2. Catch-all rule (Mandatory for Cloudflare Ingress)
  # --------------------------------------------------------------------------
  - service: http_status:404
