# SAVI Intelligence Platform - VPS Environment Configuration Template
# Copy this to .env on your VPS: cp .env.vps.example .env

# ==============================================================================
# 1. External Multi-Model API Credentials (Harvesting & Grounding Mesh)
# ==============================================================================
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
GEMMA_API_KEY=your_gemma_api_key_here
GEMMA_API_KEY_2=your_gemma_api_key_2_here
GEMMA_MODEL=gemma-4
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
OPENAI_API_KEY=your_openai_api_key_here
APIFY_API_KEY=your_apify_api_key_here
APIFY_TOKEN=your_apify_token_here

# Optional / Default Model Parameters
GEMINI_MODEL=gemma-4
OPENAI_CHAT_MODEL=gpt-4o-mini

# NousResearch Hermes Agent
HERMES_MODEL_ID=NousResearch/Hermes-3-Llama-3.1-8B
HERMES_SERVER_URL=http://127.0.0.1:8792
HERMES_MAX_STEPS=8

# ==============================================================================
# 2. Open-Jev System 1 Decision Head
# ==============================================================================
OPEN_JEV_SERVER_URL=http://127.0.0.1:8791
OPEN_JEV_MODEL_ID=ZefanCai/Open-Jev-27B-v1.1
